{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test scan_traan (Discord Embed)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/.github/scripts/scan_traan.py",
        "${input:discordEmbed}",
        "--dry-run"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "Test scan_traan (Discord Embed - Upload to Upstash)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/.github/scripts/scan_traan.py",
        "${input:discordEmbed}"
      ],
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    }
  ],
  "inputs": [
    {
      "id": "discordEmbed",
      "type": "promptString",
      "description": "Discord image URL, embed JSON, or image file path",
      "default": ""
    }
  ]
}
